    {
      "parameters": {
        "jsCode": "const text = $json.content.parts[0].text;\nconst slip = JSON.parse(text.replace(/```json|```/g, '').trim());\nconst row = $('Google Sheets Trigger').item.json;\nconst slipKey = Object.keys(row).find(k => k.startsWith('อัปโหลดสลิป'));\n\nconst result = {\n  slip_link: row[slipKey],\n  reference_number: '',\n  paid_amount: '',\n  receiver: '',\n  check_valid: false,\n  fail_reason: '',\n};\n\n// ไม่ใช่สลิป → ทุกช่องเป็น \"\" และ check_valid = FALSE\nif (slip.is_bank_slip !== true) {\n  return { json: result };\n}\n\n// เป็นสลิป → ใส่ข้อมูลจากสลิป (เงื่อนไขอื่นจะเพิ่มตรงนี้)\nresult.reference_number = slip.reference_number;\nresult.paid_amount = slip.amount;\nresult.receiver = slip.receiver_name;\nresult.check_valid = true;\nreturn { json: result };"
      },
